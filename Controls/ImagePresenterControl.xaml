<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ImageOrganizer.Controls.ImagePresenterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ImageOrganizer.Controls"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="PresentationBorder"
                Grid.Row="1"
                Background="{x:Bind Background}"
                BorderBrush="{x:Bind BorderBrush}"
                BorderThickness="{x:Bind BorderThickness}"
                CornerRadius="{x:Bind CornerRadius}"
                Margin="{x:Bind Padding}"
                PointerEntered="PresentationBorder_PointerEntered"
                PointerExited="PresentationBorder_PointerExited"
                PointerPressed="PresentationBorder_PointerPressed"
                PointerReleased="PresentationBorder_PointerReleased"
                PointerCanceled="PresentationBorder_PointerCanceled"
                PointerCaptureLost="PresentationBorder_PointerCaptureLost"
                PointerMoved="PresentationBorder_PointerMoved"
                PointerWheelChanged="PresentationBorder_PointerWheelChanged">
            <win2d:CanvasSwapChainPanel x:Name="SwapChainPanel"
                                        SizeChanged="SwapChainPanel_SizeChanged"/>
        </Border>

        <!-- Upper Toolbar -->
        <StackPanel Orientation="Horizontal"
                    Padding="3">
            <ToggleButton x:Name="MouseTransformToggleButton"
                          Width="40"
                          Height="40"
                          Padding="3"
                          IsChecked="{x:Bind InteractionMode,
                                             Converter={StaticResource InteractionModeToBoolConverter},
                                             ConverterParameter=Transform,
                                             Mode=TwoWay}">
                <FontIcon FontFamily="Segoe Fluent Icons"
                          Margin="0"
                          FontSize="30"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Glyph="&#xE962;"/>
            </ToggleButton>
            <ToggleButton x:Name="MouseCropToggleButton"
                          Width="40"
                          Height="40"
                          Padding="3"
                          IsChecked="{x:Bind InteractionMode,
                                             Converter={StaticResource InteractionModeToBoolConverter},
                                             ConverterParameter=Crop,
                                             Mode=TwoWay}">
                <FontIcon FontFamily="Segoe Fluent Icons"
                          Margin="0"
                          FontSize="30"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Glyph="&#xE7A8;"/>
            </ToggleButton>
        </StackPanel>

        <!-- Lower Toolbar -->
    </Grid>
</UserControl>