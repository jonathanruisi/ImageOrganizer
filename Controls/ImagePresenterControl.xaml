<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ImageOrganizer.Controls.ImagePresenterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ImageOrganizer.Controls"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="UserControl_KeyboardAcceleratorInvoked"/>
        <KeyboardAccelerator Key="Enter" Invoked="UserControl_KeyboardAcceleratorInvoked"/>
        <KeyboardAccelerator Key="F" Invoked="UserControl_KeyboardAcceleratorInvoked"/>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="UserControl_KeyboardAcceleratorInvoked"/>
        <KeyboardAccelerator Key="L" Invoked="UserControl_KeyboardAcceleratorInvoked"/>
        <KeyboardAccelerator Key="G" Invoked="UserControl_KeyboardAcceleratorInvoked"/>
        <KeyboardAccelerator Key="O" Invoked="UserControl_KeyboardAcceleratorInvoked"/>
    </UserControl.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="PresentationBorder"
                Grid.Row="1"
                Background="{x:Bind Background}"
                BorderBrush="{x:Bind BorderBrush}"
                BorderThickness="{x:Bind BorderThickness}"
                CornerRadius="{x:Bind CornerRadius}"
                Margin="{x:Bind Padding}"
                PointerEntered="PresentationBorder_PointerEntered"
                PointerExited="PresentationBorder_PointerExited"
                PointerPressed="PresentationBorder_PointerPressed"
                PointerReleased="PresentationBorder_PointerReleased"
                PointerCanceled="PresentationBorder_PointerCanceled"
                PointerCaptureLost="PresentationBorder_PointerCaptureLost"
                PointerMoved="PresentationBorder_PointerMoved"
                PointerWheelChanged="PresentationBorder_PointerWheelChanged">
            <win2d:CanvasSwapChainPanel x:Name="SwapChainPanel"
                                        SizeChanged="SwapChainPanel_SizeChanged"/>
        </Border>

        <!-- Upper Toolbar -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Padding="3"
                    Visibility="{x:Bind UpperToolbarVisibility, Mode=TwoWay}">
            <ToggleButton x:Name="ToggleButtonEnableCropMode"
                          Width="40"
                          Height="40"
                          Padding="3"
                          Margin="2,2,5,2"
                          IsChecked="{x:Bind EnableCropMode, Mode=TwoWay}">
                <FontIcon FontFamily="Segoe Fluent Icons"
                          Margin="0"
                          FontSize="30"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Glyph="&#xE7A8;"/>
            </ToggleButton>

            <ToggleButton x:Name="ToggleButtonLockTransform"
                          Width="40"
                          Height="40"
                          Padding="3"
                          Margin="5,2"
                          IsChecked="{x:Bind LockTransform, Mode=TwoWay}">
                <FontIcon FontFamily="Segoe Fluent Icons"
                          Margin="0"
                          FontSize="30"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Glyph="&#xEE3F;"/>
            </ToggleButton>

            <ToggleButton x:Name="ToggleButtonOverlayPreviousImage"
                          Width="40"
                          Height="40"
                          Padding="3"
                          Margin="5,2"
                          IsChecked="{x:Bind OverlayPreviousImage, Mode=TwoWay}">
                <FontIcon FontFamily="Segoe Fluent Icons"
                          Margin="0"
                          FontSize="30"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Glyph="&#xE81E;"/>
            </ToggleButton>

            <AppBarSeparator/>
            <ToggleButton x:Name="ToggleButtonShowAlignmentGrid"
                          Width="40"
                          Height="40"
                          Padding="3"
                          Margin="5,2"
                          IsChecked="{x:Bind ShowAlignmentGrid, Mode=TwoWay}">
                <FontIcon FontFamily="Segoe Fluent Icons"
                          Margin="0"
                          FontSize="30"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Glyph="&#xF232;"/>
            </ToggleButton>
        </StackPanel>

        <!-- Lower Toolbar -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Padding="3"
                    Visibility="{x:Bind LowerToolbarVisibility, Mode=TwoWay}">
            <ToggleButton x:Name="ToggleButtonAllowTranslation"
                          Width="40"
                          Height="40"
                          Padding="3"
                          Margin="2"
                          IsChecked="{x:Bind AllowManualTranslation, Mode=TwoWay}">
                <FontIcon FontFamily="Segoe Fluent Icons"
                          Margin="0"
                          FontSize="30"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Glyph="&#xE7C2;"/>
            </ToggleButton>

            <TextBlock FontFamily="Arial"
                       FontWeight="Bold"
                       FontSize="30"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       Text="X:"/>
            <TextBox x:Name="TextBoxTranslationX"
                     FontFamily="Consolas"
                     FontSize="24"
                     FontWeight="Bold"
                     TextAlignment="Center"
                     HorizontalTextAlignment="Center"
                     HorizontalContentAlignment="Center"
                     VerticalAlignment="Center"
                     Width="120"
                     Margin="2"
                     IsReadOnly="True"
                     Text="{x:Bind ImageTranslationX,
                                   Converter={StaticResource DecimalTextConverter},
                                   ConverterParameter=0.##,
                                   Mode=OneWay}"/>

            <TextBlock FontFamily="Arial"
                       FontWeight="Bold"
                       FontSize="30"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       Text="Y:"/>
            <TextBox x:Name="TextBoxTranslationY"
                     FontFamily="Consolas"
                     FontSize="24"
                     FontWeight="Bold"
                     TextAlignment="Center"
                     HorizontalTextAlignment="Center"
                     HorizontalContentAlignment="Center"
                     VerticalAlignment="Center"
                     Width="120"
                     Margin="2"
                     IsReadOnly="True"
                     Text="{x:Bind ImageTranslationY,
                                   Converter={StaticResource DecimalTextConverter},
                                   ConverterParameter=0.##,
                                   Mode=OneWay}"/>

            <AppBarSeparator Margin="10,0,0,0"/>
            <ToggleButton x:Name="ToggleButtonAllowScaling"
                          Width="40"
                          Height="40"
                          Padding="3"
                          Margin="10,0,0,0"
                          IsChecked="{x:Bind AllowManualScaling, Mode=TwoWay}">
                <FontIcon FontFamily="Segoe Fluent Icons"
                          Margin="0"
                          FontSize="30"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Glyph="&#xECE8;"/>
            </ToggleButton>

            <TextBox x:Name="TextBoxScale"
                     FontFamily="Consolas"
                     FontSize="24"
                     FontWeight="Bold"
                     TextAlignment="Center"
                     HorizontalTextAlignment="Center"
                     HorizontalContentAlignment="Center"
                     VerticalAlignment="Center"
                     Width="120"
                     Margin="10,0,0,0"
                     IsReadOnly="True"
                     Text="{x:Bind ImageScale,
                                   Converter={StaticResource DecimalTextConverter},
                                   ConverterParameter=0.##,
                                   Mode=OneWay}"/>

            <AppBarSeparator Margin="10,0,0,0"/>
            <ToggleButton x:Name="ToggleButtonAllowRotation"
                          Width="40"
                          Height="40"
                          Padding="3"
                          Margin="10,0,0,0"
                          IsChecked="{x:Bind AllowManualRotation, Mode=TwoWay}">
                <FontIcon FontFamily="Segoe Fluent Icons"
                          Margin="0"
                          FontSize="30"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Glyph="&#xE7AD;"/>
            </ToggleButton>

            <TextBox x:Name="TextBoxRotation"
                     FontFamily="Consolas"
                     FontSize="24"
                     FontWeight="Bold"
                     TextAlignment="Center"
                     HorizontalTextAlignment="Center"
                     HorizontalContentAlignment="Center"
                     VerticalAlignment="Center"
                     Width="120"
                     Margin="10,0,0,0"
                     IsReadOnly="True"
                     Text="{x:Bind ImageRotation,
                                   Converter={StaticResource DecimalTextConverter},
                                   ConverterParameter=0.##,
                                   Mode=OneWay}"/>
        </StackPanel>
    </Grid>
</UserControl>