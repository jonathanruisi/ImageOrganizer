<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ImageOrganizer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ImageOrganizer"
    xmlns:controls="using:ImageOrganizer.Controls"
    xmlns:storage="using:Windows.Storage"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ImageOrganizer">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F11" Invoked="KeyboardAcceleratorInvoked"/>
        </Grid.KeyboardAccelerators>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--Custom Title Bar-->
        <Grid x:Name="MainWindowTitleBar"
              Grid.Row="0"
              Grid.Column="0"
              Grid.ColumnSpan="3"
              Height="32"
              Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0"/>
                <ColumnDefinition x:Name="IconColumn" Width="Auto"/>
                <ColumnDefinition x:Name="TitleColumn" Width="Auto"/>
                <ColumnDefinition x:Name="MenuColumn" Width="Auto"/>
                <ColumnDefinition x:Name="DragColumn" Width="*" MinWidth="32"/>
                <ColumnDefinition x:Name="InfoColumn" Width="Auto"/>
                <ColumnDefinition x:Name="SettingsButtonColumn" Width="Auto"/>
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource AccentFillColorTertiaryBrush}"
                    BorderThickness="2"
                    CornerRadius="5,0,0,0">
                <FontIcon x:Name="TitleBarIcon"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Foreground="{ThemeResource TextOnAccentFillColorPrimary}"
                          FontFamily="Segoe Fluent Icons"
                          Glyph="&#xE91B;"/>
            </Border>

            <TextBlock x:Name="TitleBarTitle"
                       Grid.Column="2"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Text="Image Organizer"
                       Style="{StaticResource CaptionTextBlockStyle}"/>

            <MenuBar x:Name="MainMenuBar"
                     Grid.Column="3"
                     Margin="20,0,0,0"
                     Padding="0"
                     VerticalAlignment="Center">
                <MenuBarItem Title="File"
                             Margin="0"
                             Padding="0">
                    <MenuFlyoutItem Command="{x:Bind ViewModel.GeneralPreviousCommand}"/>
                    <MenuFlyoutItem Command="{x:Bind ViewModel.GeneralNextCommand}"/>
                </MenuBarItem>
                <MenuBarItem Title="Image"
                             Margin="0"
                             Padding="0">
                    <MenuFlyoutItem Command="{x:Bind ViewModel.BrowserCreateImageSequenceCommand}"/>
                    <MenuFlyoutItem Command="{x:Bind ViewModel.SaveImageTransformCommand}"/>
                </MenuBarItem>
                <MenuBarItem Title="Tools"
                             Margin="0"
                             Padding="0">
                    <MenuFlyoutItem Command="{x:Bind ViewModel.ToolsMarkDuplicatesInCurrentFolderCommand}"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutSubItem Text="Delete Flagged Items">
                        <MenuFlyoutItem Command="{x:Bind ViewModel.ToolsDeleteFlag1ItemsCommand}"
                                        CommandParameter="1"/>
                        <MenuFlyoutItem Command="{x:Bind ViewModel.ToolsDeleteFlag2ItemsCommand}"
                                        CommandParameter="2"/>
                        <MenuFlyoutItem Command="{x:Bind ViewModel.ToolsDeleteFlag3ItemsCommand}"
                                        CommandParameter="3"/>
                        <MenuFlyoutItem Command="{x:Bind ViewModel.ToolsDeleteFlag4ItemsCommand}"
                                        CommandParameter="4"/>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Command="{x:Bind ViewModel.ToolsRunWeeded1Command}"/>
                    <MenuFlyoutItem Command="{x:Bind ViewModel.ToolsRunWeeded2Command}"/>
                    <MenuFlyoutItem Command="{x:Bind ViewModel.ToolsRunWeeded3Command}"/>
                </MenuBarItem>
                <MenuBarItem Title="Help"
                             Margin="0"
                             Padding="0"/>
            </MenuBar>

            <Grid Grid.Column="5"
                  Width="350"
                  VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <TextBlock Margin="0,0,2,0"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="{x:Bind ImagePresenter.WindowDpi, Mode=OneWay}"/>
                    <TextBlock Margin="0,0,8,0"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="DPI"/>
                    <TextBlock Margin="0,0,2,0"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="{x:Bind ImagePresenter.WindowRefreshRate, Mode=OneWay}"/>
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="Hz"/>
                </StackPanel>
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           Text="VRAM"/>
                <TextBlock x:Name="VramUsedText"
                           Grid.Row="1"
                           Grid.Column="2"
                           Style="{ThemeResource CaptionTextBlockStyle}"/>
                <TextBlock x:Name="VramAvailableText"
                           Grid.Row="1"
                           Grid.Column="4"
                           Style="{ThemeResource CaptionTextBlockStyle}"/>
                <Rectangle x:Name="VramUsageIndicatorBackground"
                           Grid.Row="0"
                           Grid.Column="2"
                           Grid.ColumnSpan="3"
                           Height="12"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           StrokeThickness="2"
                           Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                           Fill="{ThemeResource ControlFillColorDefaultBrush}"/>
                <Rectangle x:Name="VramUsageIndicator"
                           Grid.Row="0"
                           Grid.Column="2"
                           Grid.ColumnSpan="3"
                           Height="8"
                           Margin="2,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           StrokeThickness="0"
                           Fill="{ThemeResource SystemColorControlAccentBrush}"/>
            </Grid>

            <Button x:Name="SettingsButton"
                    Grid.Column="6"
                    Width="28"
                    Height="28"
                    Padding="2"
                    Margin="10,0"
                    VerticalAlignment="Center">
                <FontIcon Glyph="&#xE713;"
                          FontSize="16"/>
            </Button>
        </Grid>

        <!--System Browser-->
        <controls:SystemBrowserControl x:Name="SystemBrowser"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       MinWidth="250"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"/>

        <!--Image Presenter-->
        <controls:ImagePresenterControl x:Name="ImagePresenter"
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        FontFamily="Segoe UI"
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Padding="0"
                                        Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                                        AlignmentGridBrush="HotPink"
                                        CropRectangleBrush="White"/>

        <!--Info Bar-->
        <InfoBar x:Name="MainInfoBar"
                 Grid.Row="2"
                 Grid.Column="0"
                 Grid.ColumnSpan="3"
                 IsIconVisible="True"/>

        <!--Content Sizers-->
        <toolkit:ContentSizer x:Name="SystemBrowserSizer"
                              Grid.Row="1"
                              Grid.Column="1"
                              TargetControl="{x:Bind SystemBrowser}"
                              Background="{ThemeResource ControlSolidFillColorDefaultBrush}"/>
    </Grid>
</Window>